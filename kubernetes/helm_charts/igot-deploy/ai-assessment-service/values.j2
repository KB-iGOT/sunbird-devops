### Default variable file for ai-assessment-service ###
namespace: {{ namespace }}
imagepullsecrets: {{ imagepullsecrets }}
dockerhub: {{ docker_hub_url }}
replicaCount: {{ai_assessment_replicacount|default(1)}}
repository: {{ image_ai_assessment_service }}
image_tag: {{ image_tag }}
resources:
  requests:
    cpu: {{ai_assessment_cpu_req|default('100m')}}
    memory: {{ai_assessment_mem_req|default('200Mi')}}
  limits:
    cpu: {{ai_assessment_cpu_limit|default('1')}}
    memory: {{ai_assessment_mem_limit|default('1024Mi')}}
network:
  port: {{ service_ai_assessment_port }}
  targetport: {{ service_ai_assessment_port }}
strategy:
  type: RollingUpdate
  maxsurge: {{ ai_assessment_maxsurge|default('25%') }}
  maxunavailable: {{ ai_assessment_maxunavailable|default('25%') }}
aiassessmentconfig: |-
  {
    "DB_DSN": "{{ ai_assessment_db_dsn }}",
    "GOOGLE_PROJECT_ID": "{{ ai_assessment_google_project_id }}",
    "GOOGLE_LOCATION": "us-central1",
    "GOOGLE_APPLICATION_CREDENTIALS": "/app/aswin-model-access-account.json",
    "GENAI_MODEL_NAME": "gemini-2.5-pro",
    "KARMAYOGI_API_KEY": "{{ ai_assessment_karmayogi_api_key }}",
    "LOG_LEVEL": "INFO",
    "MAX_CONCURRENCY": "50",
    "WORKER_BATCH_SIZE": "50",
    "MAX_ATTEMPTS": "3",
    "SCORM_FLAG": "false",
    "SSO_URL": "{{ ai_assessment_sso_url }}",
    "SSO_REALM": "{{ ai_assessment_sso_realm }}",
    "CLEANUP_RETENTION_DAYS": "7",
    "CLEANUP_SCHEDULE_HOUR": "3",
    "CLEANUP_SCHEDULE_MINUTE": "0",
    "KAFKA_BOOTSTRAP_SERVERS": "{{ ai_assessment_kafka_bootstrap_servers }}",
    "KAFKA_TOPIC": "{{ ai_assessment_kafka_topic }}",
    "DISABLE_AUTH_VERIFICATION": "{{ ai_assessment_disable_auth_verification|default('false') }}",
    "KAFKA_REQUEST_TOPIC": "{{ ai_assessment_kafka_request_topic }}",
    "KAFKA_GROUP_ID": "{{ ai_assessment_kafka_group_id }}"
  }
