server.port=${PORT:8080}
spring.application.name=cb-ext-rts-service
logging.level.root=INFO

# Shown in /stats, in SESSION_STATE and in log lines: POD_NAME if set, else HOSTNAME (= the pod name in Kubernetes).
pod.name=${POD_NAME:${HOSTNAME:local-1}}

rts.ws.path=/ws
rts.ws.max-frame-payload=65536
# The server pings every socket; a socket with no inbound frame (pong included) for idle-timeout is closed as lost.
rts.ws.ping-interval=20s
rts.ws.idle-timeout=50s
# Frames queued per socket before the client is treated as too slow and dropped (close 1008).
rts.ws.send-queue=256
# One log line per connect/disconnect (always on for legacy room= clients). Keep off for capacity runs.
rts.ws.log-connections=false

rts.room.max-participants=200
# true: the session is created and goes LIVE when the PC connects. false: the PC must send START_SESSION.
# Learners who connect before the PC wait (SESSION_STATE WAITING) either way.
rts.room.start-on-pc-join=true
# PC network loss: the survey pauses and ends after this wait. 0s = never end on its own.
rts.room.pc-wait-timeout=5m
rts.room.live-stats-interval=1s
rts.room.delivery-report-delay=2s
rts.room.max-text-chars=500

# One STATS line in the log every interval; also the window for the per-second rates in /stats.
rts.stats.log-interval=10s

management.endpoints.web.exposure.include=health,info,metrics,prometheus

spring.data.redis.host={{cb_ext_rts_redis}}
spring.data.redis.port={{cb_ext_rts_redis_port}}
spring.data.redis.password={{ cb_ext_rts_redis_password | default('') }}

# ---- Keycloak token check on POST /rts/v1/join (same as cb-ext-assessment-service) ----
# Realm public keys mounted at /keys/<kid> by deploy-igot (core_vault_sunbird_sso_publickey)
accesstoken.publickey.basepath={{ cb_ext_rts_backend_basepath | default('/keys/') }}
# Token iss must be sso.url + "realms/" + sso.realm
sso.url=https://{{ domain_name }}/auth/
sso.realm={{ keycloak_sso_realm }}
# Dev demo (env == 'dev' only, until the PC role in Keycloak tokens and the session service exist): demo identity
# (type a name + role on the page) and a code with no roster is claimed by its first PC. Every other environment
# keeps jwt + rosters. An inventory value (cb_ext_rts_auth_identity / cb_ext_rts_dev_claim_coordinator) still wins.
{% set rts_dev_demo = (env | default('')) == 'dev' %}
# pass: POST /rts/v1/join with the Keycloak token, then /ws?pass=... ; dev: identity in the URL, load-test runs only
rts.auth.mode={{ cb_ext_rts_auth_mode | default('pass') }}
# jwt: Keycloak token ; demo: "Bearer demo:<userId>", anyone (testing only)
rts.auth.identity={{ cb_ext_rts_auth_identity | default('demo' if rts_dev_demo else 'jwt') }}
rts.auth.jwt.role-claim={{ cb_ext_rts_role_claim | default('realm_access.roles') }}
rts.auth.jwt.coordinator-roles={{ cb_ext_rts_coordinator_roles | default('PROGRAM_COORDINATOR') }}
# X-Admin-Key for PUT /admin/sessions/{code} (rosters); empty = endpoint off
rts.auth.admin-key={{ cb_ext_rts_admin_key | default('') }}
# Testing only: a code with no roster is open to learners, the first PC claim wins
rts.auth.dev-claim-coordinator={{ cb_ext_rts_dev_claim_coordinator | default('true' if rts_dev_demo else 'false') }}
rts.auth.allowed-origins=https://{{ domain_name }}
