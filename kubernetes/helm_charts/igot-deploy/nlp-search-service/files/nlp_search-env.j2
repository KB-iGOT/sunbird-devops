GOOGLE_CLOUD_PROJECT={{nlp_search_gcp_gemini_project_id}}
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp_nlp_search_credentials.json

MODEL_NAME={{nlp_search_gemini_model_pro}}
MAX_OUTPUT_TOKENS=8192
TEMPERATURE=0
TOP_P=0.95
TOP_K=1
MAX_SEARCH_LEN=400

NLP_SEARCH_INSTRUCTION_PROMPT="find keywords from the text within square braces. \n Keywords should be name of course which user is trying to search. If a search term contains spelling mistakes, typos, or missing characters, automatically correct it to its standard dictionary form and proper context before returning it. If the search term seems to be a correct course name itself, return the search term as it is as shown in examples. Attach a priority score to keywords found based on the context of query, 1 being highest priority and larger number being lower. \n Response should be in json format as shown in Example section. \n Don't give code, just the keywords. \n ["
NPL_SEARCH_EXAMPLE_PROMPT="]\nExample: \n Query: find courses related to data mining, software architecture and AI \n Response: {\\"keywords\\" : [{\\"keyword\\" : \\"data mining\\", \\"priority\\":1}, {\\"keyword\\" : \\"software architecture\\", \\"priority\\":2}, {\\"keyword\\" : \\"AI\\", \\"priority\\":3}]} \n \n Query: Course 19th Jan \n Response: {\\"keywords\\" : [{\\"keyword\\" : \\"Course 19th Jan\\", \\"priority\\":1}]} \n\n Query: Vikshit_bharat-course-2025 \n Response: {\\"keywords\\" : [{\\"keyword\\" : \\"Vikshit_bharat-course-2025\\", \\"priority\\":1}]} \n\n Query: course by manohar kumar author\n Response: {\\"keywords\\" : [{\\"keyword\\" : \\"manohar kumar\\", \\"priority\\":1}]} \n\n Query: Curated Prg - Ivoryf Schuppea\n Response: {\\"keywords\\" : [{\\"keyword\\" : \\"Curated Prg - Ivoryf Schuppea\\", \\"priority\\":1}]} \n Answer:"

WEB_CONCURRENCY={{ nlp_web_concurrency | default('1') }}

REDIS_ENABLED=true
REDIS_HOST={{ nlpsearch_redis_host }}
REDIS_PORT={{redis_port}}
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_DB=6
REDIS_KEY_PREFIX=nlpsearch
REDIS_CACHE_TTL_DAYS=10
REDIS_QUERY_COUNTER_ENABLED=true
