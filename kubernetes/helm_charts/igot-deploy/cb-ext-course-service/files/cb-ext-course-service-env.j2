server.port={{ application_port }}
server.connection-timeout=5000
server.tomcat.max-threads=2048
server.tomcat.min-spare-threads=20
server.tomcat.max-connections=15000
server.tomcat.accept-count=500

spring.cassandra.startupTimeoutInSeconds=100000
spring.cassandra.contact-points={{ sunbird_cassandra_db_host }}
spring.cassandra.port=9042
spring.cassandra.keyspace-name={{ keyspace_sunbird }}
spring.cassandra.username={{ cassandra_username }}
spring.cassandra.password={{ cassandra_password }}
spring.cassandra.local-datacenter=DC1
sunbird_cassandra_consistency_level=ONE

cassandra.config.host={{ sunbird_cassandra_db_host }}

accesstoken.publickey.basepath=/keys/
sso.url=https://{{ domain_name }}/auth/
sso.realm={{ keycloak_sso_realm }}
sso.connection.pool.size=20
sso.enabled=true

elastic.required.field.community.json.path=/EsFieldsmapping/esRequiredFieldsJsonFilePath.json
search.string.max.regex.length=30

# HTTP Client Configuration
rest.client.connect.timeout=45000
rest.client.read.timeout=45000
rest.client.connection.request.timeout=45000
rest.client.max.connections=2000
rest.client.max.connections.per.route=500

spring.redis.data.host={{ redis_host }}
spring.redis.data.port={{ redis_port }}

user.entity.consumption.allowed.fields=userid,resourceid,last_access_time,last_completed_time,last_updated_time,lastaccesstime,lastcompletedtime,lastupdatedtime,progress,progressdetails,status
content.state.update.required.fields=contentId,status,progressdetails,completionPercentage
id.map.lookup.service.url=http://id-mapping-service:7001
id.map.lookup.bylist=/idmapping/v1/list/lookup
id.map.cache.expiry.time=14400
redis.host={{ kp_redis_ip }}
redis.port=6379
redis.timeout=84600
content-service-host=http://content-service:9000/
content-read-endpoint=content/v3/read
content-read-endpoint-fields=?fields=identifier,courseCategory
content.read.fields=identifier,courseCategory,contentType,posterImage,mediaType,reviewStatus,status,batches

cbplan.allowed.fields.update=name,endDate,id,isApar,contextData,status
cb-plan.update.publish.authorized.roles=MDO_LEADER
sb.env.chiper.password={{cipher_password}}

elastic.required.field.cb.plan.json.path=/EsRequiredFields/EsRequiredFieldsCbPlan.json
elasticsearch.host={{ elasticsearch_host }}
elasticsearch.port={{ elasticsearch_http_port }}
elasticsearch.username={{ elasticsearch_username }}
elasticsearch.password={{ elasticsearch_password }}
cb.plan.v2.index=cb_plan_alias

user.basic.details.filtered=profileCompletionPercentage,karmaPoints,certificateCount,postCount

learning_service_vm_base_url=http://{{ learningservice_ip }}:8080/learning-service
system.content.update.url=/system/v3/content/update/
spring.kafka.content.metadata.update.topic.name={{env}}.vod.content.meta.update
spring.kafka.content.metadata.update.consumer.group.id=vodContentMetaUpdateConsumerGroup
vod.bucket.prefix=gs://{{videostream_bucket}}/
vod.stream.url.prefix=https://{{domain_name}}/stream-store/

spring.kafka.bootstrap.servers={{ kafka_servers_list }}
non.text.fields=isApar,createdAt,endDate
