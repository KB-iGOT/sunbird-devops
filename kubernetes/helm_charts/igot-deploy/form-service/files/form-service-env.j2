server.port={{service_form_port}}

spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.url=jdbc:mysql://{{ mysql_host }}:3306/retail_user
spring.datasource.username={{ mysql_username }}
spring.datasource.password={{ mysql_password }}

#----------------------------- ELASTIC SEARCH CONFIGURATIONS ------------------------------#
services.esindexer.host=http://{{ elasticsearch_host }}:{{ elasticsearch_http_port }}/
services.esindexer.host.name={{ elasticsearch_host }}
services.esindexer.host.port={{ elasticsearch_http_port }}
services.esindexer.username={{ elasticsearch_username }}
services.esindexer.password={{ elasticsearch_password }}
# INDEX AND DOCUMENT TYPES
es.fs.forms.index.name=fs-forms-alias
es.fs.formsdata.index.name=fs-forms-data
es.fs.state.index.name=fs-forms-state
es.fs.statematrix.index.name=fs-forms-state-matrix
es.fs.workflowlog.index.name=fs-forms-workflow-log
es.fs.activitylog.index.name=fs-forms-activity-log

es.forms.fail.records.index.name=form-failure-records
es.forms.fail.records.index.type=formfailurerecords

file.config.path=/
file.config.name=FormConfig.yml

#----------------------------- KAFKA SERVER CONFIGURATIONS ------------------------------#
spring.kafka.bootstrap.servers={{ dp_kafka_servers_list }}

spring.kafka.producer.key-serializer=org.apache.kafka.common.serialization.StringSerializer
spring.kafka.producer.value-serializer=org.springframework.kafka.support.serializer.JsonSerializer

# KAFKA PRODUCER CONFIGURATIONS
kafka.producer.config.retries_config=0
kafka.producer.config.batch_size_config=100000
kafka.producer.config.linger_ms_config=100
kafka.producer.config.buffer_memory_config=66554432

spring.http.multipart.max-file-size=100MB
spring.http.multipart.max-request-size=100MB

#----------------------------- CLOUD STORAGE CONFIGURATIONSS ------------------------------#
cloud_storage_type=azure
azure_storage_key=storagekey
azure_storage_secret=secretkey
azure_storage_container=container

#---------------------------------- SMTP CONFIGURATIONS ------------------------------------#
mail.smtp.host={{smtp_host}}
mail.smtp.auth=true
mail.smtp.port={{smtp_port}}
mail.smtp.user={{smtp_username}}
mail.smtp.password={{smtp_password}}
mail.smtp.email=UP-SMF@tarento.com

#------- FCM ------#
fcm.service.account.filename=up-smf

#-------------------------------- USER SERVICE CONFIGURATIONS -------------------------------#
user.routes.host.url=http://localhost:8081
user.routes.getalluser.url=/user/v1/getAllUser
user.routes.getuserbyid.url=/user/getUserById
user.routes.getuserdevicetoken=/user/getDeviceTokenForUserIds

es.fs.formstag.index.name=fs-forms-tag
nps.form.id={{nps_form_id}}
nps.form.secondary.id={{ nps_form_secondary_id }}
kafka.topics.nps.survey.submission={{env}}.nps_submission
kafka.topics.nps.upgraded.survey.submission={{env}}.nps_upgraded_submission

nps.form.upgraded.id={{platform_rating_survey_id}}

es.fs.forms.index.name.v2=fs-forms-alias-v2
es.fs.formsdata.index.name.v2=fs-forms-data-alias-v2
max.allowed.page=10000
max.allowed.page.size=100
max.allowed.form.fields.size.create=100
max.allowed.form.fields.size.search=100
get.all.applications.response.size=250
es.search.timeout=30
allowed.search.filters.keys=formId,status,createdBy,createdDate,submittedBy,submittedDate,contextId,updatedBy,updatedDate,additionalProperties.batchId
# Redis configuration
redis.host.name={{ kp_redis_ip }}
redis.port={{ redis_port }}
redis.pool.max.total=3000
redis.pool.max.idle=128
redis.pool.min.idle=100
redis.pool.max.wait=5000
redis.connection.timeout=60000
cb.redis.maxIdle=128
cb.redis.maxTotal=3000
cb.redis.minIdle=100
cb.redis.testOnBorrow=true
cb.redis.testOnReturn=true
cb.redis.testWhileIdle=true
cb.redis.minEvictableIdleTimeMillis=120000
cb.redis.timeBetweenEvictionRunsMillis=30000
cb.redis.numTestsPerEvictionRun=3
cb.redis.blockWhenExhausted=true
 
#Cassandra
spring.cassandra.startupTimeoutInSeconds=100000
cassandra.config.host={{ sunbird_cassandra_db_host }}
spring.cassandra.port=9042
spring.cassandra.keyspace-name=sunbird
spring.cassandra.username=sunbird
spring.cassandra.password=""
spring.cassandra.local-datacenter=DC1
sunbird_cassandra_consistency_level=ONE
 
basic.profile.fields=id,channel,firstName,profiledetails,rootOrgId,username
allowed.fields.contexttype.map={"heading":"heading","section":"section","separator":"separator","text":"question","rating":"question","textarea":"question","dropdown":"question","checkbox":"question","radio":"question","date":"question","number":"question","boolean":"question","phone number":"question","numeric":"question","email":"question"}
allowed.form.contexttype.list=assignment
max.allowed.filter.list.size=100
userid.not.required.for.form.clientversion=0,1.0,1
form.contextType.supported=form,completionsurvey
form.contextType.hideCreatorFields=completionsurvey
