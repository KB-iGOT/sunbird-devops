DATABASE_URL={{ cbp_ai_data_base_url }}
DOCUMENT_STORAGE_TYPE=gcp
GCP_STORAGE_BUCKET={{cbp_ai_bucket}}
GCP_STORAGE_CREDENTIALS=/app/gcp_storage_credentials.json
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp_application_credentials.json
GOOGLE_EMBEDDING_MODEL={{cbp_ai_embedding_model_name}}
GOOGLE_API_KEY={{cbp_ai_google_Api_key}}
GOOGLE_PROJECT_LOCATION=us-central1
GOOGLE_PROJECT_ID={{ cbp_ai_google_project_id }}
KB_BASE_URL=https://{{ domain_name }}
KB_AUTH_TOKEN={{ cbp_ai_kb_auth_token }}
SECRET_KEY={{ cbp_ai_secret_key }}
BHASHINI_USER_ID={{ bhashini_user_id }}
BHASHINI_API_KEY={{ bhashini_api_key }}
BHASHINI_PIPELINE_ID={{ bhashini_pipeline_id }}
BHASHINI_CONFIG_API_URL={{ bhashini_config_api_url }}
