server.port={{ application_port }}
server.connection-timeout=5000
server.tomcat.max-threads=2048
server.tomcat.min-spare-threads=20
server.tomcat.max-connections=15000
server.tomcat.accept-count=500

#spring data jpa for postgres
spring.datasource.url=jdbc:postgresql://{{ postgresql_host }}:{{ postgresql_port }}/sunbird
spring.datasource.username={{postgresql_username_sunbird }}
spring.datasource.password={{ postgresql_password_sunbird }}
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.show-sql=false

spring.cassandra.local-datacenter=DC1
spring.cassandra.startupTimeoutInSeconds=100000
spring.cassandra.contact-points={{ sunbird_cassandra_db_host }}
spring.cassandra.port=9042
spring.cassandra.keyspace-name={{ keyspace_sunbird }}
spring.cassandra.username={{ cassandra_username }}
spring.cassandra.password={{ cassandra_password }}
sunbird_cassandra_consistency_level=ONE
cassandra.config.host={{ sunbird_cassandra_db_host }}

sb.api.key={{ bearer_token }}

##Authentication configuration
accesstoken.publickey.basepath=/keys/
sso.url=https://{{ domain_name }}/auth/
sso.realm={{ keycloak_sso_realm }}

#Redis Cache Service properties
#redis timeout value is in seconds
redis.timeout=84600
spring.redis.host={{ kp_redis_ip }}
spring.redis.port=6379
spring.redis.cacheTtl= 60000


#ClientHttpRequestFactory
http.client.request.factory.timeout=45000
http.pooling.client.cm.max.total.connections=2000
http.pooling.client.cm.default.max.per.route=500

# Redis pool configuration
redis.pool.max.total=3000
redis.pool.max.idle=128
redis.pool.min.idle=100
redis.pool.max.wait=5000
redis.connection.timeout=60000

redis.insights.index=12
search.result.redis.ttl=600

#kafka properties
spring.kafka.bootstrap.servers={{ kafka_servers_list }}
kafka.topic.name={{env}}.user.notification
kakfa.offset.reset.value=latest
kafka.max.poll.interval.ms=15000
kafka.max.poll.records=100
kafka.auto.commit.interval.ms=10000

mandatory.notification.max.fetch.limit=100

#Peer Validation Notification Configuration
peervalidation.bulk.user.notification.limit=100
peervalidation.notification.setting.check.enabled=false
peervalidation.use.testing.tables=true
peervalidation.list.max.fetch=100
kafka.topic.process.peer.validation={{env}}.peer.validation.status.update
kafka.group.process.peer.validation={{env}}.peer.validation.status.consumer.group
kafka.topic.process.peer.validation.error={{env}}.peer.validation.status.update.error
kafka.topic.notification.read.event={{env}}.peer.survey.notification.read

peervalidation.bulk.created.at.offset.ms=10

kafka.topic.process.peer.evaluation={{env}}.peer.evaluation.status.update
kafka.group.process.peer.evaluation={{env}}.peer.evaluation.status.consumer.group
kafka.topic.process.peer.evaluation.error={{env}}.peer.evaluation.status.update.error
kafka.topic.notification.bulk.create={{env}}.notification.bulk.create
kafka.group.notification.bulk.create={{env}}.notification.bulk.create.consumer.group
kafka.topic.notification.bulk.create.error={{env}}.notification.bulk.create.error

notification.list.peer.evaluation.assigned.excluded.statuses=SUBMITTED,IGNORED
notification.list.peer.review.assigned.excluded.statuses=APPROVED,REJECTED

cleanup.peer.validation.kafka.topics={{env}}.peer.validation.status.update,dev.peer.evaluation.status.update
cleanup.peer.validation.consumer.group.id=peer-validation-cleanup-job
cleanup.peer.validation.batch.size=100
cleanup.peer.validation.thread.pool.size=4
cleanup.peer.validation.table.requests=peer_validation_requests
cleanup.peer.validation.table.reviews=peer_validation_reviews
cleanup.peer.validation.table.audit=peer_validation_cleanup_failures
cleanup.peer.validation.window.start.time=00:01:00
cleanup.peer.validation.window.end.time=23:59:59
cleanup.peer.validation.day.offset=1
cleanup.peer.validation.poll.timeout.seconds=5
cleanup.peer.validation.executor.shutdown.timeout.minutes=10
cleanup.peer.validation.audit.deletion.prefix="DELETED:"

