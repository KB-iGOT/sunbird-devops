### Default variable file for thumbnail_generation-service ###

namespace: {{ namespace }}
imagepullsecrets: {{ imagepullsecrets }}
dockerhub: {{ docker_hub_url }}

service:
  type: {{ cb_download_proxy_type | default('LoadBalancer') }}
  cb_download_proxy_ip: {{ cb_download_proxy_ip }}  
  annotations: {{cb_download_proxy_annotations|to_json}}

env:
  javaoptions: {{cb_download_proxy_java_mem_limit|default('-Xmx600m')}}

replicaCount: {{cb_download_proxy_replicacount|default(1)}}
repository: {{ image_cb_download_proxy_service }}
image_tag: {{ image_tag }}
resources:
  requests:
    cpu: {{cb_download_proxy_cpu_req|default('200m')}}
    memory: {{cb_download_proxy_mem_req|default('200Mi')}}
  limits:
    cpu: {{cb_download_proxy_cpu_limit|default('500m')}}
    memory: {{cb_download_proxy_mem_limit|default('800Mi')}}
network:
  port: {{ service_cb_download_proxy_port }}
  targetport: {{ service_cb_download_proxy_port }}
strategy:
  type: RollingUpdate
  maxsurge: {{ cb_download_proxy_maxsurge|default('25%') }}
  maxunavailable: {{ cb_download_proxy_maxunavailable|default('25%') }}

cbdownloadproxypubkey: |-
{{cb_download_public_key | indent(2, true)}}

cbdownloadproxyprivkey: |-
{{cb_download_private_key | indent(2, true)}}

cb_download_proxy_service_account: {{ cb_download_proxy_signer_sa_email }}
serviceAccount:
  enabled: true
  name: cb-download-proxy-sa

serviceMonitor:
  enabled: true
  labels: # labels with which the prometheus choose the serviceMonitor
    app: prometheus-operator
    release: prometheus-operator

dlnginxconf: |
  # nginx.conf — from template
  # Download edge for iGOT per-org report ZIPs.
  # Mounted at /usr/local/openresty/nginx/conf/nginx.conf
  
  user  appuser;
  worker_processes auto;
  worker_rlimit_nofile 131072;
  
  # Send fatal errors to stderr so they land in container logs / Cloud Logging.
  error_log  /dev/stderr  warn;
  pid        /tmp/nginx.pid;
  
  env TICKET_ISS;
  env TICKET_AUD;
  env TICKET_PUBKEY_DIR;
  env TICKET_PUBKEY_KIDS;
  env SIGNER_SA_EMAIL;
  env REDIS_HOST;
  env REDIS_PORT;
  env REDIS_PASS;
  env REDIS_TLS;
  env GCS_METADATA_HOST;
  env REDIS_PREFIX;
  
  events {
      worker_connections 16384;
      multi_accept on;
      use epoll;
  }
  
  http {
      lua_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
      lua_ssl_verify_depth 5;
      
      include       mime.types;
      default_type  application/octet-stream;
      server_tokens off;                 # don't leak OpenResty version
  
      # ---- Streaming tuning for large report ZIPs to slow clients ----
      sendfile        on;
      tcp_nopush      on;
      tcp_nodelay     on;
      keepalive_timeout       120s;
      client_header_timeout   30s;
      client_body_timeout     30s;
  
      # A 5 GB ZIP at 1 Mbps is ~11 hours. Set timeouts to cover the worst
      # realistic case for your largest org. ADJUST to your real max file size.
      send_timeout            12h;
      proxy_read_timeout      12h;
      proxy_send_timeout      12h;
      proxy_connect_timeout   10s;
  
      # Stream straight through; never buffer multi-GB bodies to disk.
      proxy_buffering         off;
      proxy_request_buffering off;
      proxy_http_version      1.1;
  
      # ---- Lua ----
      lua_package_path "/etc/openresty/lualib/?.lua;/usr/local/openresty/lualib/?.lua;;";
      lua_shared_dict ticket_replay   128m;   # jti replay cache
      lua_shared_dict jwks_cache        1m;   # cached verification public key(s)
      lua_shared_dict signer_token      1m;   # cached GCP access token for signBlob
      lua_code_cache  on;                      # MUST be on in prod
  
      # Init the verification keys + signer once per worker.
      init_worker_by_lua_block {
          require("ticket").init()
          require("gcs_signer").init()
      }
  
      # ---- DNS resolver for dynamic upstreams ----
      # On GKE, point at the cluster DNS (kube-dns/CoreDNS) ClusterIP, OR use a
      # public resolver. ADJUST. 169.254.169.254 is the GCE metadata server and
      # is NOT a DNS resolver — do not use it here.
      resolver {{ kube_dns_ip }} ipv6=off valid=30s;
      resolver_timeout 5s;
  
      map $status $nginx_reject_reason {
          401 "nginx_unauthorized";
          403 "nginx_forbidden";
          404 "not_found";
          429 "rate_limited";
          default "nginx_unclassified";
      }
  
      map $sent_http_x_audit_reject $audit_reject_reason {
          default $sent_http_x_audit_reject;
          ""      $nginx_reject_reason;
      }

      map $request_uri $block_bad_uri {
        default 0;
        ~*%5c                1;
        ~*%2e%2e             1;
        ~*\.\.               1;
        ~*%252e%252e         1;
        ~*%00                1;
      }
      # ---- Audit logging (JSON → Cloud Logging via stdout) ----
      log_format edge_audit escape=json
          '{'
          '"ts":"$time_iso8601",'
          '"severity":"INFO",'
          '"remote_addr":"$remote_addr",'
          '"req_id":"$request_id",'
          '"method":"$request_method",'
          '"uri":"$uri",'
          '"status":$status,'
          '"bytes_sent":$bytes_sent,'
          '"duration_s":$request_time,'
          '"upstream_status":"$upstream_status",'
          '"user_id":"$sent_http_x_audit_user",'
          '"file_id":"$sent_http_x_audit_file",'
          '"ticket_jti":"$sent_http_x_audit_jti",'
          '"reject_reason":"$audit_reject_reason"'
          '}';
  
      access_log /dev/stdout edge_audit;
  
      # ---- Real client IP ----
      # The GCP external HTTPS LB sets X-Forwarded-For. Trust ONLY the GCP LB
      # ranges so a client cannot spoof XFF. These are GCP's documented LB
      # source ranges; verify against current GCP docs before deploy.
      set_real_ip_from 130.211.0.0/22;
      set_real_ip_from 35.191.0.0/16;
      real_ip_header   X-Forwarded-For;
      real_ip_recursive on;
  
      # ---- TLS (terminated here only if NOT terminating at the GCP LB) ----
      # If the GCP HTTPS LB terminates TLS (recommended), the edge listens on
      # plain HTTP behind it and this block is unused. See docs/CONFIG_GUIDE.md.
      ssl_protocols TLSv1.2 TLSv1.3;
      ssl_prefer_server_ciphers off;
      ssl_session_cache shared:SSL:10m;
      ssl_session_timeout 1h;
  
      include /usr/local/openresty/nginx/conf/edge.conf;
  }

dledgeconf: |
  # edge.conf — production
  # The download vhost. Sits behind the GCP external HTTPS load balancer.
  # TLS is terminated at the LB, so this listens on plain HTTP on the pod port.
  
  upstream gcs_upstream {
      server storage.googleapis.com:443;
      keepalive 64;
      keepalive_requests 1000;
      keepalive_timeout 60s;
  }
  
  # Pre-auth flood protection on the redeem endpoint.
  limit_req_zone  $binary_remote_addr zone=edge_redeem:20m rate=20r/s;
  limit_conn_zone $binary_remote_addr zone=edge_conn:20m;
  
  server {
      # Behind the GCP LB. The LB does TLS; we speak HTTP on 8080.
      listen 8080;
      server_name dl.{{ static_domain_name }};
  
      # Hard caps to blunt abuse.
      limit_conn edge_conn 8;          # max 8 concurrent downloads per client IP
  
      # Security headers on every response.
      add_header X-Content-Type-Options nosniff always;
      add_header X-Frame-Options DENY always;
      #add_header Referrer-Policy no-referrer always;
      # HSTS is set by the LB / on the HTTPS listener; if set here it is harmless.
      add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
      add_header Referrer-Policy "strict-origin";
      add_header Permissions-Policy "geolocation=(),midi=(),sync-xhr=(),microphone=(),camera=(),magnetometer=(),gyroscope=(),fullscreen=(self),payment=()";
      add_header Cache-Control "max-age=0";
      proxy_hide_header X-XSS-Protection;
      proxy_set_header    Host              $host;
      proxy_set_header    X-Real-IP         {{ nginx_client_public_ip_header | d('$remote_addr') }};
      proxy_set_header    X-Forwarded-SSL   on;
      proxy_set_header    X-Forwarded-Proto $scheme;      
  
      if ($block_bad_uri) {                                                                                                                               
         return 400;                                                                                                                                             
      } 
      # Health/readiness for the GCP LB and GKE probes. No auth, no logging.
      location = /health {
          access_log off;
          default_type 'text/plain';
          return 200 'ok';
      }
      location = /ready {
          access_log off;
          content_by_lua_block {
              -- Ready only if keys + signer initialized.
              local ok = require("ticket").is_ready() and require("gcs_signer").is_ready()
              if ok then ngx.status = 200; ngx.say("ready")
              else ngx.status = 503; ngx.say("not-ready") end
          }
      }
  
      # =========================================================================
      # Download endpoint
      # =========================================================================
      location ~ ^/download/v3/operational/report/(?<file_id>[A-Za-z0-9_-]+)$ {
          limit_req zone=edge_redeem burst=40 nodelay;
  
          set $gcs_bucket '';
          set $gcs_object '';
          set $gcs_signed_query '';
          set $download_filename '';
  
          access_by_lua_block {
              local ticket = require "ticket"
              local signer = require "gcs_signer"
  
              -- 1. Extract ticket (query param preferred; header fallback).
              local args = ngx.req.get_uri_args()
              local jwt_str = args.t or args.ticket
              if not jwt_str then
                  local auth = ngx.var.http_authorization
                  if auth then jwt_str = auth:match("^Bearer%s+(.+)$") end
              end
              if not jwt_str then
                  ngx.header["X-Audit-Reject"] = "missing_ticket"
                  return ngx.exit(401)
              end
  
              -- 2. Verify JWT (RS256, key from JWKS cache). Validates sig, exp,
              --    nbf, iss, aud, required claims, and jti replay.
              local claims, err = ticket.verify(jwt_str)
              if not claims then
                  ngx.header["X-Audit-Reject"] = "ticket_invalid:" .. (err or "?")
                  return ngx.exit(401)
              end
  
              -- 3. file_id in path must equal file_id in ticket.
              if claims.fid ~= ngx.var.file_id then
                  ngx.header["X-Audit-Reject"] = "file_id_mismatch"
                  return ngx.exit(403)
              end
  
              -- 4. Client IP must match the bound IP .
              local client_ip = ngx.var.remote_addr
              -- if claims.ip ~= client_ip then
              --     ngx.header["X-Audit-Reject"] = "ip_mismatch"
              --     return ngx.exit(403)
              -- end
  
              -- 5. Session still valid in Redis (concurrent-session policy).
              local ok, rerr = ticket.check_session(claims.uid, claims.sid, claims.jti)
              if not ok then
                  ngx.header["X-Audit-Reject"] = "session_invalid:" .. (rerr or "?")
                  return ngx.exit(403)
              end
  
              -- extract filename from JWT
              local filename = claims.fname or (claims.fid .. ".zip")
              -- security cleanup
              filename = string.gsub(filename, "[\r\n\"]", "")
              filename = string.gsub(filename, "[/\\]", "_")
              filename = string.gsub(filename, "%s+", "_")
              filename = string.gsub(filename, "[^%w%._%-]", "")
  
              -- trim underscores that may appear from cleanup
              filename = string.gsub(filename, "^_+", "")
              filename = string.gsub(filename, "_+$", "")
  
              -- ensure .zip is present only if not already there
              filename = filename:gsub("%s+$", "")
              if not filename:lower():match("%.zip$") then
                  filename = filename .. ".zip"
              end
  
              -- final safety fallback
              if filename == nil or filename == "" then
                  filename = (claims.fid .. ".zip")
              end
              ngx.var.download_filename = filename
  
              -- 6. Sign an internal GCS V4 URL via IAM signBlob. Short TTL,
              --    IP-locked. Never leaves this process.
              local signed_query, serr = signer.sign_v4(claims.bkt, claims.obj, {
                  ttl_seconds = 300,
                  method      = "GET",
              })
              if not signed_query then
                  ngx.log(ngx.ERR, "sign failed: ", serr)
                  ngx.header["X-Audit-Reject"] = "sign_failed"
                  return ngx.exit(502)
              end
  
              ngx.var.gcs_bucket       = claims.bkt
              ngx.var.gcs_object       = claims.obj
              ngx.var.gcs_signed_query = signed_query
  
              -- Audit headers (consumed by log_format via $sent_http_*).
              ngx.header["X-Audit-User"] = claims.uid
              ngx.header["X-Audit-File"] = claims.fid
              ngx.header["X-Audit-Jti"]  = claims.jti
          }
  
          proxy_pass https://gcs_upstream/$gcs_bucket/$gcs_object$gcs_signed_query;
          proxy_ssl_server_name on;
          proxy_ssl_name storage.googleapis.com;
          proxy_set_header Host      storage.googleapis.com;
          proxy_set_header Range     $http_range;
          proxy_set_header If-Range  $http_if_range;
          proxy_pass_request_headers off;
          proxy_pass_request_body    off;
  
          proxy_pass_header Content-Length;
          proxy_pass_header Content-Range;
          proxy_pass_header Accept-Ranges;
          proxy_pass_header ETag;
          proxy_pass_header Last-Modified;
  
          # Don't leak the audit headers or GCS internals to the client.
          proxy_hide_header x-goog-hash;
          proxy_hide_header x-goog-generation;
          proxy_hide_header x-goog-metageneration;
          proxy_hide_header x-goog-stored-content-encoding;
          proxy_hide_header x-goog-stored-content-length;
          proxy_hide_header x-goog-storage-class;
          proxy_hide_header alt-svc;
          more_clear_headers "X-Audit-User" "X-Audit-File" "X-Audit-Jti" "X-Audit-Reject";
  
          # Force a download disposition with the ZIP name from the ticket if you
          # want; otherwise GCS object metadata governs. Optional.
          # add_header Content-Disposition 'attachment' always;
          add_header Content-Disposition "attachment; filename*=UTF-8''$download_filename" always;
      }
  
      # Everything else is 404. No directory listing, no debug endpoints in prod.
      location / { return 404; }
  }

autoscaling:
  enabled: {{ cb_download_proxy_autoscaling_enabled | default('false') }}
  minReplicas: {{ cb_download_proxy_autoscaling_minReplicas|default(1) }}
  maxReplicas: {{ cb_download_proxy_autoscaling_maxReplicas|default(2) }}
  targetCPUUtilizationPercentage: {{ cb_download_proxy_autoscaling_targetCPUUtilizationPercentage|default(60) }}
  targetMemoryUtilizationPercentage: {{ cb_download_proxy_autoscaling_targetMemoryUtilizationPercentage|default('') }}

