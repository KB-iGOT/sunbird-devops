### Default variable file for cb-ext-config-service ###

namespace: {{ namespace }}
imagepullsecrets: {{ imagepullsecrets }}
dockerhub: {{ docker_hub_url }}


env:
  javaoptions: {{cb_ext_config_java_mem_limit|default('-Xmx600m')}}

replicaCount: {{cb_ext_config_replicacount|default(1)}}
repository: {{ image_cb_ext_config_service }}
image_tag: {{image_tag}}
resources:
  requests:
    cpu: {{cb_ext_config_cpu_req|default('100m')}}
    memory: {{cb_ext_config_mem_req|default('100Mi')}}
  limits:
    cpu: {{cb_ext_config_cpu_limit|default('1')}}
    memory: {{cb_ext_config_mem_limit|default('1024Mi')}}
network:
  port: {{ service_cb_ext_config_port }}
  targetport: {{ service_cb_ext_config_port }}
strategy:
  type: RollingUpdate
  maxsurge: {{ cb_ext_config_maxsurge|default('25%') }}
  maxunavailable: {{ cb_ext_config_maxunavailable|default('25%') }}

healthcheck: true
livenessProbe:
  httpGet:
    path: /cbextconfig/actuator/health
    port: {{ service_cb_ext_config_port }}
  initialDelaySeconds: 30
  periodSeconds: 30
  timeoutSeconds: 15
  failureThreshold: 2
readinessProbe:
  httpGet:
    path: /cbextconfig/actuator/health
    port: {{ service_cb_ext_config_port }}
  initialDelaySeconds: 30
  periodSeconds: 30
  timeoutSeconds: 15
  failureThreshold: 2
cb_ext_config_backend_basepath: {{ cb_ext_config_backend_basepath | default('/keys/') }}

serviceMonitor:
  enabled: true
  labels: # labels with which the prometheus choose the serviceMonitor
    app: prometheus-operator
    release: prometheus-operator

autoscaling:
  enabled: {{ cb_ext_config_service_autoscaling_enabled | default('false') }}
  minReplicas: {{ cb_ext_config_service_autoscaling_minReplicas|default(1) }}
  maxReplicas: {{ cb_ext_config_service_autoscaling_maxReplicas|default(2) }}
  targetCPUUtilizationPercentage: {{ cb_ext_config_service_autoscaling_targetCPUUtilizationPercentage|default(60) }}
  targetMemoryUtilizationPercentage: {{ cb_ext_config_service_autoscaling_targetMemoryUtilizationPercentage|default('') }}

