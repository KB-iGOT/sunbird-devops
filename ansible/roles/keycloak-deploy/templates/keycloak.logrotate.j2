{{ keycloak_home }}/logs/keycloak.log {
    daily
    rotate 30
    missingok
    notifempty
    compress
    delaycompress
    dateext
    copytruncate
    create 0644 {{ wildfly_user }} {{ wildfly_group }}

    lastaction
        mkdir -p {{ log_backup_dir }}
        rsync -a {{ keycloak_home }}/logs/keycloak.log* {{ log_backup_dir }}
    endscript
}