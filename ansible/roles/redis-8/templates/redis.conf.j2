# {{ ansible_managed }}
# Redis {{ redis_version }} configuration

################################## NETWORK #####################################
bind {{ redis_bind }}
protected-mode {{ redis_protected_mode }}
port {{ redis_port }}
tcp-backlog 511
timeout 0
tcp-keepalive 300

################################# GENERAL #####################################
# systemd manages the process (Type=notify)
daemonize no
supervised systemd
pidfile {{ redis_data_dir }}/redis_{{ redis_port }}.pid
loglevel notice
logfile "{{ redis_data_dir }}/redis.log"
databases {{ redis_databases }}

################################## SECURITY ###################################
# Password for the "default" user. Every client must AUTH with it.
requirepass {{ redis_password }}

################################ SNAPSHOTTING  ################################
save 900 1
save 300 10
save 60 10000
stop-writes-on-bgsave-error yes
rdbcompression yes
rdbchecksum yes
dbfilename dump.rdb
dir "{{ redis_data_dir }}"

################################# REPLICATION #################################
# (slave-* names from the 6.2 config are now replica-*)
# If you add replicas, they also need:  masterauth <same password>
replica-serve-stale-data yes
replica-read-only yes
repl-diskless-sync yes
repl-diskless-sync-delay 5
repl-disable-tcp-nodelay no
replica-priority 100

############################## MEMORY MANAGEMENT ##############################
{% if redis_maxmemory %}
maxmemory {{ redis_maxmemory }}
{% endif %}
maxmemory-policy {{ redis_maxmemory_policy }}

############################## APPEND ONLY MODE ###############################
appendonly {{ redis_appendonly }}
appendfilename "appendonly.aof"
appenddirname "appendonlydir"
appendfsync everysec
no-appendfsync-on-rewrite no
auto-aof-rewrite-percentage 100
auto-aof-rewrite-min-size 64mb
aof-load-truncated yes
aof-use-rdb-preamble yes

################################ LUA / SLOW LOG ###############################
lua-time-limit 5000
slowlog-log-slower-than 10000
slowlog-max-len 128
latency-monitor-threshold 0
notify-keyspace-events ""

############################### ADVANCED CONFIG ###############################
# (ziplist settings from 6.2 are now listpack)
hash-max-listpack-entries 512
hash-max-listpack-value 64
list-max-listpack-size -2
list-compress-depth 0
set-max-intset-entries 512
set-max-listpack-entries 128
set-max-listpack-value 64
zset-max-listpack-entries 128
zset-max-listpack-value 64
hll-sparse-max-bytes 3000
activerehashing yes
client-output-buffer-limit normal 0 0 0
client-output-buffer-limit replica 256mb 64mb 60
client-output-buffer-limit pubsub 32mb 8mb 60
hz 10
dynamic-hz yes
aof-rewrite-incremental-fsync yes
rdb-save-incremental-fsync yes
